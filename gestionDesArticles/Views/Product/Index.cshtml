@model IEnumerable<gestionDesArticles.Models.Product>

@{
    ViewData["Title"] = "Liste des produits";
}

<h1>Liste des produits</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<div class="row">
@foreach (var item in Model)
{
    var photoPath = "~/images/" + (item.Image ?? "noimage.jpg");
    <div class="col-md-3 mb-3">
        <div class="card h-100">
            <img src="@photoPath" asp-append-version="true" class="card-img-top" style="height:150px;object-fit:cover;" />
            <div class="card-body">
                <h5 class="card-title">@item.Name</h5>
                <p class="card-text">Prix: @item.Price</p>
                <p class="card-text">Quantité: @item.QteStock</p>
                <p class="card-text">Catégorie: @item.Category?.CategoryName</p>
                <a asp-action="Details" asp-route-id="@item.ProductId" class="btn btn-outline-secondary">Détails</a>
                <a asp-controller="Panier" asp-action="AddProduct" class="btn btn-outline-secondary" asp-route-id="@item.ProductId">Ajouter Au Panier</a>
            </div>
        </div>
    </div>
}
</div>

<!-- Pagination -->
<div class="pagination">
    @for (int i = 1; i <= ViewBag.TotalPages; i++)
    {
        <a asp-action="Index" asp-route-categoryId="@ViewBag.CategoryId"
           asp-route-page="@i" class="btn btn-secondary m-1">
            @i
        </a>
    }
</div>
